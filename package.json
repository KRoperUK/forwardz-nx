  "description": "Generate NSP to NRO forwarders for Switch",
  "nacp": {
    "id": "01c7d19eae2a0000",
    "title": "Forwardz",
    "userAccountSaveDataSize": "0"
  },
  "scripts": {
    "build": "esbuild --bundle --sourcemap --sources-content=false --target=es2022 --format=esm --outdir=romfs --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" src/main.tsx",
    "format": "biome format --write src",
    "lint": "biome lint",
    "nro": "pnpm run build && nxjs-nro",
    "nsp": "pnpm run build && nxjs-nsp",
    "typecheck": "tsc"
  },
  "author": {
    "name": "Nathan Rajlich",
    "email": "n@n8.io"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "dependencies": {
    "@nx.js/clkrst": "^1.0.1",
    "@nx.js/constants": "^0.4.1",
    "@nx.js/install-title": "^0.0.3",
    "@nx.js/ncm": "^1.2.0",
    "@tootallnate/nacp": "^0.2.1",
    "jimp": "1.6.1",
    "react": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "react-tela": "^1.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
